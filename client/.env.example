# ==============================================================================
# Festive Ad Studio - Frontend Environment Variables (.env)
# ==============================================================================

# Backend API Base URL
# - In local development: Leave empty to use Vite's built-in dev proxy, or set to http://localhost:5000
# - In production (Vercel / Netlify / Render / GitHub Pages):
#   Set to the public URL of your deployed backend (e.g., https://diwali-api.onrender.com)
#   Note: Do not append a trailing slash.
VITE_API_URL=http://localhost:5000
