# ==============================================================================
# Festive Ad Studio - Backend Environment Variables (.env)
# ==============================================================================

# Port the Express server listens on (Render/Railway/Heroku inject PORT automatically)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# CORS Allowed Origin(s)
# - In local development: http://localhost:5173
# - In production: Set to your live frontend URL (e.g. https://diwali-studio.vercel.app)
#   Multiple origins can be comma-separated: https://site.vercel.app,https://yourdomain.com
#   Use '*' to allow all origins.
CORS_ORIGIN=*
